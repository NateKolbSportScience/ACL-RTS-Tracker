			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion")
			RETURN
			CALCULATE(AVERAGE('rtp_latestForceFrames'[R Max Force (N)]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Date] = LatestDate)
		formatString: 0
		lineageTag: 815d068d-b003-504b-a0e8-43ccb6e85ee8

	measure 'Latest Quad L (N)' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)")
			RETURN
			CALCULATE(AVERAGE('rtp_latestForceFrames'[L Max Force (N)]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)",
			    'rtp_latestForceFrames'[Date] = LatestDate)
		formatString: 0
		lineageTag: a5dc8aa6-38a6-5bb1-bd5c-764202413872

	measure 'Latest Quad R (N)' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)")
			RETURN
			CALCULATE(AVERAGE('rtp_latestForceFrames'[R Max Force (N)]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)",
			    'rtp_latestForceFrames'[Date] = LatestDate)
		formatString: 0
		lineageTag: 62675fa8-17be-513c-9cda-33d281fe3fa9

	measure 'Status Icon' =
			
			VAR MetricName = MAX('Criteria'[Metric Name])
			RETURN
			SWITCH(
			    MetricName,
			    "KF Strength Asym %",        [KF Status],
			    "KE Strength Asym %",        [KE Status],

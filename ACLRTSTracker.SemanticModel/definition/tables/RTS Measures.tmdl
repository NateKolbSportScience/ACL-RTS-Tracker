table 'RTS Measures'
	lineageTag: 70737ac5-e0e9-455b-8239-97bf5e4c13ad

	measure 'Current Phase' =
			
			LOOKUPVALUE('Phases'[Phase Name], 'Phases'[Phase ID], MAX('Athlete'[Current Phase ID]))
		lineageTag: 4b77eaea-8cac-45e0-bfe7-57feea8a79bc

	measure 'As Of Date' =
			
			MAXX(
			    {
			        CALCULATE(MAX('rtp_latestCMJ'[Date])),
			        CALCULATE(MAX('rtp_latestSquat'[Date])),
			        CALCULATE(MAX('rtp_latestSLStand'[Date])),
			        CALCULATE(MAX('rtp_latestForceFrames'[Date]))
			    },
			    [Value]
			)
		formatString: d mmm yyyy
		lineageTag: 3f91ed9c-aba4-5050-b0c2-2b707e056fc2

	measure 'Months Post-Op (Auto)' =
			
			VAR SurgeryDate = MAX('Athlete'[Surgery Date])
			VAR AsOf = [As Of Date]
			RETURN
			IF(ISBLANK(SurgeryDate) || ISBLANK(AsOf), BLANK(), DATEDIFF(SurgeryDate, AsOf, MONTH))
		formatString: 0
		lineageTag: 1573e32b-e1f1-583a-8f19-3627fd288d07

	measure 'Latest KF Strength Asym %' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull")
			VAR CurrentValue = CALCULATE(AVERAGE('rtp_latestForceFrames'[Max Imbalance]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Date] = LatestDate,
			    NOT(ISBLANK('rtp_latestForceFrames'[Max Imbalance])))
			RETURN
			IF(ISBLANK(CurrentValue) || CurrentValue = 0, BLANK(), CurrentValue)
		lineageTag: 1f81b85c-cbc3-46a1-b3af-1840de7595be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest KE Strength Asym %' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)")
			VAR CurrentValue = CALCULATE(AVERAGE('rtp_latestForceFrames'[Max Imbalance]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)",
			    'rtp_latestForceFrames'[Date] = LatestDate)
			RETURN
			IF(ISBLANK(CurrentValue) || CurrentValue = 0, BLANK(), CurrentValue)
		lineageTag: 1f2405f3-2b03-4978-add7-004139a99f33

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest KF/KE RFD Asym %' =
			
			VAR LatestKFDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull")
			VAR LRFD = CALCULATE(AVERAGE('rtp_latestForceFrames'[L Max RFD (N/s)]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Date] = LatestKFDate)
			VAR RRFD = CALCULATE(AVERAGE('rtp_latestForceFrames'[R Max RFD (N/s)]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Date] = LatestKFDate)
			RETURN
			IF(ISBLANK(LRFD) || ISBLANK(RRFD) || (LRFD + RRFD) = 0, BLANK(),
			    ABS(LRFD - RRFD) / ((LRFD + RRFD) / 2) * 100)
		lineageTag: 7fdbf919-c68e-44c2-be44-8ec284dfe5a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest CMJ Ecc Decel Asym %' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestCMJ'[Date]),
			    'rtp_latestCMJ'[Test Type] = "CMJ")
			RETURN
			CALCULATE(MAX('rtp_latestCMJ'[Eccentric Braking Impulse % (Asym) Direction]),
			    'rtp_latestCMJ'[Test Type] = "CMJ",
			    'rtp_latestCMJ'[Date] = LatestDate)
		lineageTag: fbd85dbd-c793-4e9d-9b74-bfdb30d45c91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest CMJ Conc Asym %' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestCMJ'[Date]),
			    'rtp_latestCMJ'[Test Type] = "CMJ")
			RETURN
			CALCULATE(MAX('rtp_latestCMJ'[Concentric Impulse % (Asym) Direction]),
			    'rtp_latestCMJ'[Test Type] = "CMJ",
			    'rtp_latestCMJ'[Date] = LatestDate)
		formatString: 0
		lineageTag: eb22d258-1125-48b4-8363-33bf4c9d83a6

	measure 'Latest HQ Ratio L' =
			
			DIVIDE([Latest Ham L (N)], [Latest Quad L (N)])
		formatString: 0.00
		lineageTag: 0ab63de2-ba6c-5d5a-96c1-1e16d71ab8ed

	measure 'Latest HQ Ratio R' =
			
			DIVIDE([Latest Ham R (N)], [Latest Quad R (N)])
		formatString: 0.00
		lineageTag: c1809b21-5966-5b38-8eb1-92c8c8658ff6

	measure 'KF Strength Asym Pass' =
			
			VAR Threshold = CALCULATE(MAX('Criteria'[Threshold]),
			    'Criteria'[Metric Name] = "KF Strength Asym %",
			    'Criteria'[Phase ID] = MAX('Athlete'[Current Phase ID]))
			VAR CurrentValue = [Latest KF Strength Asym %]
			RETURN
			IF(ISBLANK(CurrentValue), BLANK(),
			    IF(CurrentValue <= Threshold, 1, 0))
		formatString: 0
		lineageTag: 68566c69-64b9-44f8-a080-190e7efc1a54

	measure 'KE Strength Asym Pass' =
			
			VAR Threshold = CALCULATE(MAX('Criteria'[Threshold]),
			    'Criteria'[Metric Name] = "KE Strength Asym %",
			    'Criteria'[Phase ID] = MAX('Athlete'[Current Phase ID]))
			VAR CurrentValue = [Latest KE Strength Asym %]
			RETURN
			IF(ISBLANK(CurrentValue), BLANK(),
			    IF(CurrentValue <= Threshold, 1, 0))
		formatString: 0
		lineageTag: 2304bc3c-7adc-4078-8f86-f67480cd8b9f

	measure 'KF/KE RFD Asym Pass' =
			
			VAR Threshold = CALCULATE(MAX('Criteria'[Threshold]),
			    'Criteria'[Metric Name] = "KF/KE RFD Asym %",
			    'Criteria'[Phase ID] = MAX('Athlete'[Current Phase ID]))
			VAR CurrentValue = [Latest KF/KE RFD Asym %]
			RETURN
			IF(ISBLANK(CurrentValue), BLANK(),
			    IF(CurrentValue <= Threshold, 1, 0))
		formatString: 0
		lineageTag: 079297c8-1199-49d3-a29e-10ed67aa1e86

	measure 'CMJ Ecc Decel Asym Pass' =
			
			VAR Threshold = CALCULATE(MAX('Criteria'[Threshold]),
			    'Criteria'[Metric Name] = "CMJ Ecc Decel Asym %",
			    'Criteria'[Phase ID] = MAX('Athlete'[Current Phase ID]))
			VAR CurrentValue = ABS([Latest CMJ Ecc Decel Asym %])
			RETURN
			IF(ISBLANK(CurrentValue), BLANK(),
			    IF(CurrentValue <= Threshold, 1, 0))
		formatString: 0
		lineageTag: 70386e35-9d6c-40d6-b8e8-3633ee09c691

	measure 'CMJ Conc Asym Pass' =
			
			VAR Threshold = CALCULATE(MAX('Criteria'[Threshold]),
			    'Criteria'[Metric Name] = "CMJ Conc Asym %",
			    'Criteria'[Phase ID] = MAX('Athlete'[Current Phase ID]))
			VAR CurrentValue = ABS([Latest CMJ Conc Asym %])
			RETURN
			IF(ISBLANK(CurrentValue), BLANK(),
			    IF(CurrentValue <= Threshold, 1, 0))
		formatString: 0
		lineageTag: 2db145ef-34bb-4916-8d47-4c3ef5a22cc6

	measure 'Criteria Met' =
			
			SUMX(
			    VALUES('Criteria'[Metric Name]),
			    SWITCH(
			        'Criteria'[Metric Name],
			        "KF Strength Asym %",    [KF Strength Asym Pass],
			        "KE Strength Asym %",    [KE Strength Asym Pass],
			        "KF/KE RFD Asym %",      [KF/KE RFD Asym Pass],
			        "CMJ Ecc Decel Asym %",  [CMJ Ecc Decel Asym Pass],
			        "CMJ Conc Asym %",       [CMJ Conc Asym Pass],
			        0
			    )
			)
		formatString: 0
		lineageTag: 4b12928a-6879-4e07-a66d-8a175f6e0136

	measure 'Criteria Total' =
			
			CALCULATE(
			    COUNTROWS('Criteria'),
			    'Criteria'[Phase ID] = MAX('Athlete'[Current Phase ID]))
		formatString: 0
		lineageTag: c4999c05-213b-4afa-9540-459cb7619b39

	measure 'Criteria Progress %' =
			
			DIVIDE([Criteria Met], [Criteria Total], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b76f4ac0-ed93-424a-8923-af2a82ce2e0f

	measure 'Athlete Photo HTML' =
			
			VAR Label = SELECTEDVALUE('Athlete'[Name], "Select an athlete")
			VAR Limb = SELECTEDVALUE('Athlete'[Operated Limb], "")
			VAR Photo = SELECTEDVALUE('Athlete'[Photo URL], "")
			VAR Badge =
			    "<svg viewBox='0 0 64 64' style='width:62%;max-height:70%;'><circle cx='32' cy='32' r='31' fill='#3A4634' stroke='#E3C770' stroke-width='2'/>" &
			    "<circle cx='32' cy='25' r='10' fill='#E3C770'/><path d='M14 52c2-11 9-16 18-16s16 5 18 16z' fill='#E3C770'/></svg>"
			VAR Picture =
			    IF(Photo = "", Badge,
			        "<img src='" & Photo & "' style='width:62%;max-height:70%;aspect-ratio:1;object-fit:cover;border-radius:50%;border:2px solid #E3C770;'/>")
			RETURN
			"<div style='width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:Segoe UI;'>" &
			Picture &
			"<div style='color:#F1EEE2;font-size:13px;font-weight:600;margin-top:6px;'>" & Label & "</div>" &
			"<div style='color:#BDBBA6;font-size:11px;'>" & IF(Limb = "", "", Limb & " ACL") & "</div></div>"
		lineageTag: 221acd91-61b7-5731-871a-6b43c17d2fc1

	measure 'KF Strength Asym Color' =
			
			VAR CurrentValue = [Latest KF Strength Asym %]
			VAR PassFail = [KF Strength Asym Pass]
			RETURN
			IF(ISBLANK(CurrentValue), "#5A6650",
			    IF(PassFail = 1, "#6CC28A", "#F07167"))
		lineageTag: d5446e94-7ff1-4d25-8b9a-54b0a61193a4

	measure 'KE Strength Asym Color' =
			
			VAR CurrentValue = [Latest KE Strength Asym %]
			VAR PassFail = [KE Strength Asym Pass]
			RETURN
			IF(ISBLANK(CurrentValue), "#5A6650",
			    IF(PassFail = 1, "#6CC28A", "#F07167"))
		lineageTag: 8e811239-7eff-4990-966e-8c2da72edca0

	measure 'CMJ Ecc Decel Asym Color' =
			
			VAR CurrentValue = [Latest CMJ Ecc Decel Asym %]
			VAR PassFail = [CMJ Ecc Decel Asym Pass]
			RETURN
			IF(ISBLANK(CurrentValue), "#5A6650",
			    IF(PassFail = 1, "#6CC28A", "#F07167"))
		lineageTag: 0fd39e80-d2d8-454a-a9ec-8c8ad9d23d0a

	measure 'CMJ Conc Asym Color' =
			
			VAR CurrentValue = [Latest CMJ Conc Asym %]
			VAR PassFail = [CMJ Conc Asym Pass]
			RETURN
			IF(ISBLANK(CurrentValue), "#5A6650",
			    IF(PassFail = 1, "#6CC28A", "#F07167"))
		lineageTag: b868c4cf-aae0-47af-ac45-08813d93bdf0

	measure 'Current Value' =
			
			SWITCH(
			    MAX('Criteria'[Metric Name]),
			    "KF/KE Strength Asym %",     ABS([Latest KF/KE Strength Asym %]),
			    "KF Strength Asym %",        ABS([Latest KF Strength Asym %]),
			    "KE Strength Asym %",        ABS([Latest KE Strength Asym %]),
			    "Iso Leg Ext Asym %",        ABS([Latest Iso Leg Ext Asym %]),
			    "KF RFD Asym %",             ABS([Latest KF RFD Asym %]),
			    "KE RFD Asym %",             ABS([Latest KE RFD Asym %]),
			    "CMJ Ecc Decel Asym %",      ABS([Latest CMJ Ecc Decel Asym %]),
			    "CMJ Conc Asym %",           ABS([Latest CMJ Conc Asym %]),
			    "Squat Ecc Decel Asym %",    [Latest Squat Ecc Decel Asym %],
			    "SL Stand Total Excursion L", [Latest SL Stand Excursion L],
			    "SL Stand Total Excursion R", [Latest SL Stand Excursion R],
			    "KF Prone Asym %",           [Latest KF Prone Asym %],
			    "KE 45 Asym %",              [Latest KE 45 Asym %],
			    "Hip Abd Asym %",            [Latest Hip Abd Asym %],
			    "Hip Add Asym %",            [Latest Hip Add Asym %],
			    0
			)
		lineageTag: ce5cfb72-c33f-41fb-a060-dc71e92c756d

	measure 'Status Color' =
			
			SWITCH(
			    MAX('Criteria'[Metric Name]),
			    "KF Strength Asym %",   IF(ISBLANK([Latest KF Strength Asym %]), "#5A6650", IF([KF Strength Asym Pass] = 1, "#6CC28A", "#F07167")),
			    "KE Strength Asym %",   IF(ISBLANK([Latest KE Strength Asym %]), "#5A6650", IF([KE Strength Asym Pass] = 1, "#6CC28A", "#F07167")),
			    "KF/KE RFD Asym %",     IF(ISBLANK([Latest KF/KE RFD Asym %]), "#5A6650", IF([KF/KE RFD Asym Pass] = 1, "#6CC28A", "#F07167")),
			    "CMJ Ecc Decel Asym %", IF(ISBLANK([Latest CMJ Ecc Decel Asym %]), "#5A6650", IF([CMJ Ecc Decel Asym Pass] = 1, "#6CC28A", "#F07167")),
			    "CMJ Conc Asym %",      IF(ISBLANK([Latest CMJ Conc Asym %]), "#5A6650", IF([CMJ Conc Asym Pass] = 1, "#6CC28A", "#F07167")),
			    "#5A6650"
			)
		lineageTag: 4f191fef-21b2-40d5-a039-249421aa3021

	measure 'Phase Rail HTML' =
			
			VAR CurrentPhase = SELECTEDVALUE('Athlete'[Current Phase ID])
			VAR Met1 = SUMX(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "1"), IF(LEFT(CALCULATE([Status Icon]), 1) = "✓", 1, 0))
			VAR Tot1 = COUNTROWS(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "1"))
			VAR Met2 = SUMX(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "2"), IF(LEFT(CALCULATE([Status Icon]), 1) = "✓", 1, 0))
			VAR Tot2 = COUNTROWS(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "2"))
			VAR Met3 = SUMX(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "3"), IF(LEFT(CALCULATE([Status Icon]), 1) = "✓", 1, 0))
			VAR Tot3 = COUNTROWS(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "3"))
			VAR Met4 = SUMX(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "4"), IF(LEFT(CALCULATE([Status Icon]), 1) = "✓", 1, 0))
			VAR Tot4 = COUNTROWS(FILTER(ALL('Criteria'), 'Criteria'[Phase ID] = "4"))
			VAR Done1 = TRUE() && Met1 = Tot1 && Tot1 > 0
			VAR Done2 = Done1 && Met2 = Tot2 && Tot2 > 0
			VAR Done3 = Done2 && Met3 = Tot3 && Tot3 > 0
			VAR Done4 = Done3 && Met4 = Tot4 && Tot4 > 0
			RETURN
			"<div style='display:flex;align-items:stretch;width:100%;height:100%;'>" &
			"<div style='flex:1;margin:4px;padding:8px 6px;border-radius:8px;text-align:center;font-family:Segoe UI;background:" & IF(Done1, "#6CC28A", "#3A4634") & ";color:" & IF(Done1, "#1E2419", IF((CurrentPhase = "1"), "#F1EEE2", "#BDBBA6")) & ";border:2px solid " & IF((CurrentPhase = "1"), "#E3C770", IF(Done1, "#6CC28A", "#3A4634")) & ";'>" & "<div style='font-size:15px;font-weight:700;'>Mid Rehab" & IF(Done1, " ✓", "") & "</div>" & "<div style='font-size:10px;opacity:.8;'>2–4 months" & IF((CurrentPhase = "1"), " · CURRENT", "") & "</div>" & "<div style='height:6px;background:rgba(0,0,0,.25);border-radius:3px;margin:6px 6px 3px;'><div style='height:6px;border-radius:3px;width:" & FORMAT(DIVIDE(Met1, Tot1, 0) * 100, "0") & "%;background:" & IF(Done1, "#1E2419", IF((CurrentPhase = "1"), "#F2C14E", "#6CC28A")) & ";'></div></div>" & "<div style='font-size:11px;'>" & Met1 & " / " & Tot1 & " criteria met</div></div>" &
			"<div style='color:#F1EEE2;opacity:.35;font-size:16px;'>▶</div>" &
			"<div style='flex:1;margin:4px;padding:8px 6px;border-radius:8px;text-align:center;font-family:Segoe UI;background:" & IF(Done2, "#6CC28A", "#3A4634") & ";color:" & IF(Done2, "#1E2419", IF((CurrentPhase = "2"), "#F1EEE2", "#BDBBA6")) & ";border:2px solid " & IF((CurrentPhase = "2"), "#E3C770", IF(Done2, "#6CC28A", "#3A4634")) & ";'>" & "<div style='font-size:15px;font-weight:700;'>Late Rehab" & IF(Done2, " ✓", "") & "</div>" & "<div style='font-size:10px;opacity:.8;'>4–6 months" & IF((CurrentPhase = "2"), " · CURRENT", "") & "</div>" & "<div style='height:6px;background:rgba(0,0,0,.25);border-radius:3px;margin:6px 6px 3px;'><div style='height:6px;border-radius:3px;width:" & FORMAT(DIVIDE(Met2, Tot2, 0) * 100, "0") & "%;background:" & IF(Done2, "#1E2419", IF((CurrentPhase = "2"), "#F2C14E", "#6CC28A")) & ";'></div></div>" & "<div style='font-size:11px;'>" & Met2 & " / " & Tot2 & " criteria met</div></div>" &
			"<div style='color:#F1EEE2;opacity:.35;font-size:16px;'>▶</div>" &
			"<div style='flex:1;margin:4px;padding:8px 6px;border-radius:8px;text-align:center;font-family:Segoe UI;background:" & IF(Done3, "#6CC28A", "#3A4634") & ";color:" & IF(Done3, "#1E2419", IF((CurrentPhase = "3"), "#F1EEE2", "#BDBBA6")) & ";border:2px solid " & IF((CurrentPhase = "3"), "#E3C770", IF(Done3, "#6CC28A", "#3A4634")) & ";'>" & "<div style='font-size:15px;font-weight:700;'>RTP" & IF(Done3, " ✓", "") & "</div>" & "<div style='font-size:10px;opacity:.8;'>6–9 months" & IF((CurrentPhase = "3"), " · CURRENT", "") & "</div>" & "<div style='height:6px;background:rgba(0,0,0,.25);border-radius:3px;margin:6px 6px 3px;'><div style='height:6px;border-radius:3px;width:" & FORMAT(DIVIDE(Met3, Tot3, 0) * 100, "0") & "%;background:" & IF(Done3, "#1E2419", IF((CurrentPhase = "3"), "#F2C14E", "#6CC28A")) & ";'></div></div>" & "<div style='font-size:11px;'>" & Met3 & " / " & Tot3 & " criteria met</div></div>" &
			"<div style='color:#F1EEE2;opacity:.35;font-size:16px;'>▶</div>" &
			"<div style='flex:1;margin:4px;padding:8px 6px;border-radius:8px;text-align:center;font-family:Segoe UI;background:" & IF(Done4, "#6CC28A", "#3A4634") & ";color:" & IF(Done4, "#1E2419", IF((CurrentPhase = "4"), "#F1EEE2", "#BDBBA6")) & ";border:2px solid " & IF((CurrentPhase = "4"), "#E3C770", IF(Done4, "#6CC28A", "#3A4634")) & ";'>" & "<div style='font-size:15px;font-weight:700;'>RTS" & IF(Done4, " ✓", "") & "</div>" & "<div style='font-size:10px;opacity:.8;'>9–12 months" & IF((CurrentPhase = "4"), " · CURRENT", "") & "</div>" & "<div style='height:6px;background:rgba(0,0,0,.25);border-radius:3px;margin:6px 6px 3px;'><div style='height:6px;border-radius:3px;width:" & FORMAT(DIVIDE(Met4, Tot4, 0) * 100, "0") & "%;background:" & IF(Done4, "#1E2419", IF((CurrentPhase = "4"), "#F2C14E", "#6CC28A")) & ";'></div></div>" & "<div style='font-size:11px;'>" & Met4 & " / " & Tot4 & " criteria met</div></div>" &
			"</div>"
		lineageTag: 03baf9e1-7706-5792-906c-8244b378d496

	measure 'Current Phase Filter' =
			
			IF(MAX('Criteria'[Phase ID]) = MAX('Athlete'[Current Phase ID]), 1, 0)
		formatString: 0
		lineageTag: 4f80af6f-03d8-4326-bda6-af4d6713b110

	measure 'Latest Ham L (N)' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion")
			RETURN
			CALCULATE(AVERAGE('rtp_latestForceFrames'[L Max Force (N)]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Date] = LatestDate)
		formatString: 0
		lineageTag: f135e625-613d-5a17-939e-ebcf9ae3f499


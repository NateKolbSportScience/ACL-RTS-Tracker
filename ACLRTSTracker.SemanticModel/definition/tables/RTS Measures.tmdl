	measure 'Latest KE RFD Asym %' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)")
			VAR LRFD = CALCULATE(AVERAGE('rtp_latestForceFrames'[L Max RFD (N/s)]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)",
			    'rtp_latestForceFrames'[Date] = LatestDate)
			VAR RRFD = CALCULATE(AVERAGE('rtp_latestForceFrames'[R Max RFD (N/s)]),
			    'rtp_latestForceFrames'[Test] = "Knee Extension",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Position] = "Knee Extension - Seated (90)",
			    'rtp_latestForceFrames'[Date] = LatestDate)
			RETURN
			IF(ISBLANK(LRFD) || ISBLANK(RRFD) || (LRFD + RRFD) = 0, BLANK(),
			    ABS(LRFD - RRFD) / ((LRFD + RRFD) / 2) * 100)
		lineageTag: 0b63ac92-7ce2-46c7-94e5-f604c411561f

		annotation PBI_FormatHint = {"isGeneralNumber":true}


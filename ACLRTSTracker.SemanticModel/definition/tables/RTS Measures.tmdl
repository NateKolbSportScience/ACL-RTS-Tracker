	measure 'FF Show Date' =
			
			VAR D = MAX('rtp_latestForceFrames'[Date])
			VAR Surgery = SELECTEDVALUE('Athlete'[Surgery Date])
			VAR AllDates = CALCULATETABLE(VALUES('rtp_latestForceFrames'[Date]), REMOVEFILTERS('rtp_latestForceFrames'[Date]))
			VAR Baseline = MAXX(FILTER(AllDates, [Date] < Surgery), [Date])
			VAR PostRank = COUNTROWS(FILTER(AllDates, (ISBLANK(Surgery) || [Date] >= Surgery) && [Date] > D)) + 1
			RETURN
			IF(ISBLANK(D), BLANK(), IF((NOT ISBLANK(Surgery) && D = Baseline) || ((ISBLANK(Surgery) || D >= Surgery) && PostRank <= 6), 1, BLANK()))
		formatString: 0
		lineageTag: 115a9ac8-5715-5892-add1-36889cd2f3a2

	measure 'Ham Bar Operated (N)' = IF([FF Show Date] = 1, [KF Operated (N)])
		formatString: 0

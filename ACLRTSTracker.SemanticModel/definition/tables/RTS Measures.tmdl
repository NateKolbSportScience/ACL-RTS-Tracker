	measure 'KF Operated Limb Deficit' =
			
			VAR LatestDate = CALCULATE(MAX('rtp_latestForceFrames'[Date]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull")
			VAR LForce = CALCULATE(AVERAGE('rtp_latestForceFrames'[L Max Force (N)]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Date] = LatestDate)
			VAR RForce = CALCULATE(AVERAGE('rtp_latestForceFrames'[R Max Force (N)]),
			    'rtp_latestForceFrames'[Test] = "Knee Flexion",
			    'rtp_latestForceFrames'[Direction] = "Pull",
			    'rtp_latestForceFrames'[Date] = LatestDate)
			VAR OperatedLimb = MAX('Athlete'[Operated Limb])
			VAR OperatedForce = IF(OperatedLimb = "Right", RForce, LForce)
			VAR NonOperatedForce = IF(OperatedLimb = "Right", LForce, RForce)
			RETURN
			IF(ISBLANK(OperatedForce) || ISBLANK(NonOperatedForce), BLANK(),
			    DIVIDE(OperatedForce, NonOperatedForce) * 100)

	measure 'Phase Rail HTML Hamstring' =
			
			VAR CurrentPhase = [Current Phase]
			VAR Phase1Color = IF(CurrentPhase = "Early", "#F07167", "#3A4634")
			VAR Phase2Color = IF(CurrentPhase = "Mid", "#F2C14E", "#3A4634")
			VAR Phase3Color = IF(CurrentPhase = "RTS", "#7FB7BE", "#3A4634")
			RETURN
			"<div style=""display:flex;align-items:center;width:100%;"">" &
			"<div style=""flex:1;text-align:center;background:" & Phase1Color & ";color:#F1EEE2;padding:16px 8px;border-radius:8px;font-size:16px;font-weight:bold;margin:4px;"">Early<br/><span style=""font-size:12px;font-weight:normal;opacity:0.8;"">0–2 weeks</span></div>" &
			"<div style=""color:#F1EEE2;opacity:0.3;padding:0 4px;font-size:20px;"">▶</div>" &
			"<div style=""flex:1;text-align:center;background:" & Phase2Color & ";color:#F1EEE2;padding:16px 8px;border-radius:8px;font-size:16px;font-weight:bold;margin:4px;"">Mid<br/><span style=""font-size:12px;font-weight:normal;opacity:0.8;"">2–4 weeks</span></div>" &
			"<div style=""color:#F1EEE2;opacity:0.3;padding:0 4px;font-size:20px;"">▶</div>" &
			"<div style=""flex:1;text-align:center;background:" & Phase3Color & ";color:#F1EEE2;padding:16px 8px;border-radius:8px;font-size:16px;font-weight:bold;margin:4px;"">RTS<br/><span style=""font-size:12px;font-weight:normal;opacity:0.8;"">4–6 weeks</span></div>" &
			"</div>"
		lineageTag: 4a5ac4f7-8d25-4cdb-b542-bff4a1e8728e

